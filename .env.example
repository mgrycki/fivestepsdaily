# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
WEB_SEARCH_TOOL=web_search_20250305

# --- Meta (Facebook Page + Instagram Business) ---
GRAPH_API_VERSION=v21.0
PAGE_ID=1234567890
IG_USER_ID=1784...
PAGE_ACCESS_TOKEN=EAAG...          # long-lived Page token (~60 days)
META_APP_ID=...                    # only for refresh_token.py
META_APP_SECRET=...                # only for refresh_token.py

# --- X (OAuth 1.0a, Read+Write) ---
X_CONSUMER_KEY=...
X_CONSUMER_SECRET=...
X_ACCESS_TOKEN=...
X_ACCESS_TOKEN_SECRET=...

# --- Illustration (any OpenAI-compatible /images/generations endpoint) ---
IMAGE_API_KEY=sk-...                        # leave empty to publish icon-only frames
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
IMAGE_TRANSPARENT=1                         # set 0 if your provider rejects the flag
IMAGE_TIMEOUT=240

# --- Object storage (Cloudflare R2 / S3, public read) ---
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=publisher
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_REGION=auto
PUBLIC_BASE_URL=https://media.example.com   # public host mapped to the bucket

# --- Reels (HeyGen Video Agent) ---
HEYGEN_API_KEY=...                          # empty = reel step skipped
HEYGEN_AVATAR_ID=                           # optional; only used when REEL_FACELESS=0
HEYGEN_VOICE_ID=                            # optional; auto-picked when empty
HEYGEN_STYLE_ID=                            # optional; GET /v3/video-agents/styles
HEYGEN_BRAND_KIT_ID=                        # optional
HEYGEN_TIMEOUT=1800                         # seconds to wait for the render
REEL_LANGUAGE=en                            # en | pl | de | es | fr (spoken + on-screen)
REEL_SECONDS=50
REEL_FACELESS=1                             # 1 = voice-over + b-roll, 0 = presenter
REEL_TARGETS=instagram,facebook,youtube,x

# --- YouTube (scripts/youtube_auth.py prints all three) ---
YT_CLIENT_ID=...
YT_CLIENT_SECRET=...
YT_REFRESH_TOKEN=...
YT_PRIVACY=public

# --- Behaviour ---
TARGETS=facebook,instagram,x
BRAND_HANDLE=@yourhandle
X_CHAR_LIMIT=280            # raise to 25000 if the account has X Premium
